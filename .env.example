# ===============================================
# CONFIGURACIÓN DE ENTORNO - COMSEPROA v2.0
# ===============================================
# Copia este archivo como .env y configura con tus datos reales

# ===============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===============================================
DB_HOST=localhost
DB_USERNAME=tu_usuario_bd
DB_PASSWORD=tu_contraseña_bd
DB_NAME=comseproa_db
DB_CHARSET=utf8mb4
DB_PORT=3306

# ===============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===============================================
APP_NAME="COMSEPROA Inventory System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com

# ===============================================
# CONFIGURACIÓN DE SESIONES
# ===============================================
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_DOMAIN=

# ===============================================
# CONFIGURACIÓN DE LOGS
# ===============================================
LOG_LEVEL=error
LOG_PATH=logs/
LOG_MAX_FILES=10

# ===============================================
# CONFIGURACIÓN DE SEGURIDAD
# ===============================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# ===============================================
# CONFIGURACIÓN DE EMAIL (Futuro)
# ===============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_contraseña_email
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@tu-dominio.com
MAIL_FROM_NAME="COMSEPROA System"

# ===============================================
# CONFIGURACIÓN AVANZADA
# ===============================================
# Zona horaria
TIMEZONE=America/Lima

# Cache (en segundos)
CACHE_LIFETIME=3600

# Límites de archivos
UPLOAD_MAX_SIZE=10M
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# API Rate Limiting
API_RATE_LIMIT=100

# ===============================================
# CONFIGURACIÓN DE DESARROLLO (Solo development)
# ===============================================
# Descomenta estas líneas solo para desarrollo local
# APP_ENV=development
# APP_DEBUG=true
# DB_HOST=localhost
# SESSION_SECURE=false